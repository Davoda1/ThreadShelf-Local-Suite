[17.727745, "o", "\u001b[32m✔ native Gemini activity JSON and normalized ThreadShelf export retain original indexes \u001b[90m(1.097534ms)\u001b[39m\u001b[39m\r\n"]
[17.72776, "o", "\u001b[32m✔ ChatGPT -index HTML parses strict jsonData without script execution or double-converting Markdown \u001b[90m(6.112032ms)\u001b[39m\u001b[39m\r\n"]
[17.727773, "o", "\u001b[32m✔ combined normalized roles split into separate renderable turns with original shared index \u001b[90m(0.617621ms)\u001b[39m\u001b[39m\r\n"]
[17.727797, "o", "\u001b[32m✔ ThreadShelf CLI bare normalized turn arrays import and exported stable keys roundtrip \u001b[90m(1.691788ms)\u001b[39m\u001b[39m\r\n"]
