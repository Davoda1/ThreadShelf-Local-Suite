[7.490727, "o", "\u001b[32m✔ normalized-only server copies use earliest dated turn once; explicit source dates win and unknown dates remain unknown \u001b[90m(2.630292ms)\u001b[39m\u001b[39m\r\n"]
[7.778687, "o", "\u001b[32m✔ normalized starts drive calendar, drilldown, range and model filters without changing messages or stored originals \u001b[90m(291.079151ms)\u001b[39m\u001b[39m\r\n"]
[8.016592, "o", "\u001b[32m✔ normalized start estimates update incrementally, preserve copy reuse and survive restart \u001b[90m(238.421844ms)\u001b[39m\u001b[39m\r\n"]
[8.221611, "o", "\u001b[32m✔ Revision 2 zero-start cache repairs automatically without archive mutation or manual rebuild \u001b[90m(203.672954ms)\u001b[39m\u001b[39m\r\n"]
[8.373209, "o", "\u001b[32m✔ old text cache refreshes source dates and retained-source precedence from headers only without recompressing blocks \u001b[90m(151.957711ms)\u001b[39m\u001b[39m\r\n"]
[8.649493, "o", "\u001b[32m✔ custom dates reject missing, noncanonical, impossible and reversed intervals without fallback \u001b[90m(4.068869ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ all time, calendar years and rolling year preserve existing interval selection \u001b[90m(0.239631ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cross-year custom interval includes both day boundaries across totals, distributions, rows and CSV \u001b[90m(283.411315ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ custom intervals combine correctly with branch, metric, bucket, model and date drilldown \u001b[90m(135.22328ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ local calendar boundaries and DST use the selected time zone without truncating the inclusive day \u001b[90m(115.606435ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ empty and single-day ranges remain exact; extreme ranges retain the sparse memory guard \u001b[90m(224.835525ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ invalid custom requests reject before opening or rebuilding an index \u001b[90m(115.476454ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ normalized estimated starts have identical provenance in desktop and offline preview across date filters \u001b[90m(275.648583ms)\u001b[39m\u001b[39m\r\n"]
[8.761608, "o", "\u001b[32m✔ opening Activity on a 2.0-compatible profile preserves archive identities, originals and reading across restart \u001b[90m(710.796272ms)\u001b[39m\u001b[39m\r\n"]
[8.761765, "o", "\u001b[32m✔ service query, rebuild and CSV preserve exact custom date filters and leave source reading intact \u001b[90m(416.26478ms)\u001b[39m\u001b[39m\r\n"]
[9.577976, "o", "\u001b[32m✔ import, reimport, new messages, rebuild and reopen keep Conversations started accurate \u001b[90m(817.417211ms)\u001b[39m\u001b[39m\r\n"]
[10.732085, "o", "\u001b[32m✔ Activity follows rename, move, copy and deletion without changing source identity or retaining cleared conversations \u001b[90m(1153.684912ms)\u001b[39m\u001b[39m\r\n"]
[11.707501, "o", "\u001b[32m✔ Activity remains rebuildable when storage compression changes in either direction \u001b[90m(975.154496ms)\u001b[39m\u001b[39m\r\n"]
[12.627403, "o", "\u001b[32m✔ restoring an older backup discards newer Activity data and retains restored IDs and reading \u001b[90m(919.62314ms)\u001b[39m\u001b[39m\r\n"]
[13.174128, "o", "\u001b[32m✔ a damaged compressed Activity cache rebuilds from intact source and private temporary data is cleaned on close \u001b[90m(546.780188ms)\u001b[39m\u001b[39m\r\n"]
[13.657192, "o", "\u001b[32m✔ conversion cancels and drains Activity before closing the SQLite handles it uses \u001b[90m(483.070194ms)\u001b[39m\u001b[39m\r\n"]
[14.007664, "o", "\u001b[32m✔ CSV uses the current Local filters and does not include unrelated collections \u001b[90m(349.013307ms)\u001b[39m\u001b[39m\r\n"]
[14.20451, "o", "\u001b[32m✔ Server Insights calls only the summary endpoint and never mounts Local storage during Server-only use \u001b[90m(198.081034ms)\u001b[39m\u001b[39m\r\n"]
[14.353552, "o", "\u001b[32m✔ explicit Insights cancellation rejects stale scope and the next summary request remains usable \u001b[90m(149.18938ms)\u001b[39m\u001b[39m\r\n"]
[14.372533, "o", "\u001b[32m✔ original ChatGPT counts empty messages once, own timestamps and active branch precisely \u001b[90m(2.338652ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ normalized records count stored turns and mark earliest-turn start estimates \u001b[90m(1.634692ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ timestamp validation rejects invalid dates, booleans and import-style junk \u001b[90m(0.367374ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ branch fallback and cycles are reported without infinite traversal \u001b[90m(0.378651ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ Activity report calendar, graphs, coverage, model/date drilldown and safe CSV \u001b[90m(224.445367ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ unchanged and metadata-only archive edits reuse analytics without source decoding \u001b[90m(199.340267ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ copied conversations reuse identical indexed content, and deletion reconciles rows \u001b[90m(181.775655ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a restored different archive with the same revision cannot reuse prior analytics \u001b[90m(178.317196ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ compressed cache reopens without content reads; corrupt cache safely rebuilds \u001b[90m(153.278991ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ version 1 derived metadata is automatically repaired, even with an unchanged archive revision \u001b[90m(313.394379ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ profile changes recode derived database and discard removes its retained metadata \u001b[90m(143.368238ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ pre-aborted analytics leaves original data unchanged \u001b[90m(107.945355ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ startup reclaims only marked stale working directories after interruption \u001b[90m(119.93693ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancellation during one large conversation rolls back its index and allows retry \u001b[90m(623.930456ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ finalized ZIP retains data beyond 4 MiB and its complete central directory on disk \u001b[90m(244.385291ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ archive sink has a hard size bound and does not retain reused compressor buffers \u001b[90m(1.096451ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ truncated write is rejected before replacing the previous release artifact \u001b[90m(7.62151ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ managed rename truncation is repaired from the complete buffer and independently verified \u001b[90m(68.838565ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ failed flush never replaces a previous artifact or leaves an accepted temporary ZIP \u001b[90m(6.012511ms)\u001b[39m\u001b[39m\r\n"]
[14.592813, "o", "\u001b[32m✔ v2 catalog and durable mutation records contain references, never source bodies \u001b[90m(106.860407ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ copies, moves and renames share immutable payloads; update forks only changed identity \u001b[90m(152.458835ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ scattered reads and global streaming scans remain within the decoded block cache budget \u001b[90m(876.267482ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ one oversized message and opaque raw record span bounded objects losslessly \u001b[90m(4295.2352ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ both compression conversions preserve IDs, metadata, sparse turns and logical search revision \u001b[90m(557.97529ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ failed/cancelled conversion leaves catalog references unchanged \u001b[90m(202.009011ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ corrupt immutable objects fail explicitly while summary-only browsing remains available \u001b[90m(83.535536ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ recovery replays references from the durable content directory and remains idempotent \u001b[90m(124.238767ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ literal list and manager filters retain SQLite ASCII/Unicode/escaping behavior \u001b[90m(463.730734ms)\u001b[39m\u001b[39m\r\n"]
[14.593439, "o", "\u001b[32m✔ content reads and writes reject a symlinked objects directory \u001b[90m(83.675981ms)\u001b[39m\u001b[39m\r\n"]
[14.593447, "o", "\u001b[32m✔ different valid encodings of identical logical content coexist without replacing committed objects \u001b[90m(139.942542ms)\u001b[39m\u001b[39m\r\n"]
[14.683439, "o", "\u001b[32m✔ fresh archive excludes empty collections and persists all files beneath user data \u001b[90m(24.52723ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ native IDs deduplicate copied files and preserve raw fields across restart \u001b[90m(123.565408ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ updates replace indexed passages atomically and keep identity \u001b[90m(125.516483ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ failure during catalog publication rolls back conversation content references and revision together \u001b[90m(170.223394ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ providers, local collection namespaces, and server provenance do not collide \u001b[90m(440.180959ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ empty text and multiple role parts retain exact original turn indexes \u001b[90m(78.445866ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ listing filters and paging use summaries without full source documents \u001b[90m(706.579217ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ invalid updates do not change stored data \u001b[90m(69.38564ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ search roles distinguish imported tools and systems while assistant aliases resolve \u001b[90m(76.385162ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ application database has expected SQLite header and safe close/reopen behavior \u001b[90m(55.532659ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ C01: original native GenUI envelope reaches supported adapter without rewriting \u001b[90m(23.198282ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ C02: original native GenUI envelope reaches supported adapter without rewriting \u001b[90m(1.882346ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ C03: original native GenUI envelope reaches supported adapter without rewriting \u001b[90m(1.356303ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ C04: original native GenUI envelope reaches supported adapter without rewriting \u001b[90m(1.349232ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ C05: original native GenUI envelope reaches supported adapter without rewriting \u001b[90m(1.301871ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ C07: original native GenUI envelope reaches supported adapter without rewriting \u001b[90m(1.893502ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ C09: original native GenUI envelope reaches supported adapter without rewriting \u001b[90m(0.713104ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ native counts, percentages, signs and horizontal bounds retain exact semantics \u001b[90m(2.843643ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ native line series/order and numeric scatter preserve zeros, fractions and identity \u001b[90m(1.274781ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ widget pie is locally presented as ring without changing source type/raw values \u001b[90m(1.250544ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ series suffix, explicit empty suffix and explicit unit override chart inheritance \u001b[90m(3.250426ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ shared numeric axis labels never borrow an incompatible series suffix or unit \u001b[90m(1.440409ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ metadata and all source keys remain in preserved native source; no input mutation \u001b[90m(10.608439ms)\u001b[39m\u001b[39m\r\n"]
[14.683489, "o", "\u001b[32m✔ R01: existing Reader-owned presentation through component message remains accepted \u001b[90m(4.932009ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ R02: existing Reader-owned presentation through component message remains accepted \u001b[90m(0.824342ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ R03: existing Reader-owned presentation through component message remains accepted \u001b[90m(1.100547ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ R04: existing Reader-owned presentation through component message remains accepted \u001b[90m(0.668287ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ R05: existing Reader-owned presentation through component message remains accepted \u001b[90m(0.50494ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ R06: existing Reader-owned presentation through component message remains accepted \u001b[90m(0.546383ms)\u001b[39m\u001b[39m\r\n"]
