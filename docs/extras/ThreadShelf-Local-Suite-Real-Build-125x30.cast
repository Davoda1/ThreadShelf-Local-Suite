[14.684131, "o", "\u001b[32m✔ fish: actual tokens and exact source round trip \u001b[90m(5.963142ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ shell: actual tokens and exact source round trip \u001b[90m(0.713835ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ PowerShell: actual tokens and exact source round trip \u001b[90m(8.428124ms)\u001b[39m\u001b[39m\r\n"]
[14.684181, "o", "\u001b[32m✔ console: actual tokens and exact source round trip \u001b[90m(1.998861ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ all 193 upstream grammars remain, plus dedicated Fish \u001b[90m(1.836647ms)\u001b[39m\u001b[39m\r\n"]
