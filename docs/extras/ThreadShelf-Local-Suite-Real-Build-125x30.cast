[17.728007, "o", "\u001b[32m✔ raw assistant and reasoning JSON becomes readable two-space code text \u001b[90m(1.775234ms)\u001b[39m\u001b[39m\r\n"]
[17.72802, "o", "\u001b[32m✔ formatting preserves duplicate keys, exact numbers, escaped strings and key order \u001b[90m(0.396758ms)\u001b[39m\u001b[39m\r\n"]
