[14.683533, "o", "\u001b[32m✔ native Chart and chart contracts accept evidenced types without adding unknown families \u001b[90m(1.724408ms)\u001b[39m\u001b[39m\r\n"]
[14.68355, "o", "\u001b[32m✔ unknown versions, unsupported chart semantics/layouts and unrecognized fields fall back \u001b[90m(11.19312ms)\u001b[39m\u001b[39m\r\n"]
[14.683567, "o", "\u001b[32m✔ nonnumeric cells, absent/ambiguous key mappings and clipping bounds retain bounded fallback \u001b[90m(4.482602ms)\u001b[39m\u001b[39m\r\n"]
[14.683599, "o", "\u001b[32m✔ circular zero/negative data and single positive slice are handled without fake shares \u001b[90m(1.197284ms)\u001b[39m\u001b[39m\r\n"]
[14.683643, "o", "\u001b[32m✔ data-only snapshot rejects accessors, nonfinite/executable values, symbols and prototypes \u001b[90m(1.346048ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ size/node/depth budgets and missing rows do not become unbounded adapters \u001b[90m(11.45139ms)\u001b[39m\u001b[39m\r\n"]
[14.683665, "o", "\u001b[32m✔ invalid fragments and malformed literals cannot swallow later valid siblings \u001b[90m(7.549812ms)\u001b[39m\u001b[39m\r\n"]
[14.683683, "o", "\u001b[32m✔ fenced JSON and native envelopes in code remain literal; passive data is preserved \u001b[90m(2.43649ms)\u001b[39m\u001b[39m\r\n"]
[14.683887, "o", "\u001b[32m✔ C01: native component and legacy wrapper preserve widget rendering semantics \u001b[90m(23.56541ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ C02: native component and legacy wrapper preserve widget rendering semantics \u001b[90m(4.670575ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ C03: native component and legacy wrapper preserve widget rendering semantics \u001b[90m(1.898785ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ C04: native component and legacy wrapper preserve widget rendering semantics \u001b[90m(1.210408ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ C05: native component and legacy wrapper preserve widget rendering semantics \u001b[90m(2.170089ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ C07: native component and legacy wrapper preserve widget rendering semantics \u001b[90m(2.084369ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ C09: native component and legacy wrapper preserve widget rendering semantics \u001b[90m(1.119166ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ native horizontal bars retain direction, exact percentages and bounds \u001b[90m(0.785753ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ native scatter metadata is retained without turning point order into labels \u001b[90m(0.931332ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ native chart support does not relax unknown fields, layouts or data validation \u001b[90m(4.359496ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ converter-created Markdown tables remain passive and are not reconstructed as charts \u001b[90m(3.545381ms)\u001b[39m\u001b[39m\r\n"]
