[428.495321, "o", "\u001b[32m✔ new producer version explicitly supports old snapshot readers; established IDs do not change \u001b[90m(8.759027ms)\u001b[39m\u001b[39m\r\n"]
[428.52351, "o", "\u001b[32m✔ JSON-LD WebPage cannot hide a valid static conversation \u001b[90m(33.0592ms)\u001b[39m\u001b[39m\r\n"]
[428.603321, "o", "\u001b[32m✔ unrelated backupVersion and similarly named chunk preserve ordinary ZIP conversations \u001b[90m(78.703662ms)\u001b[39m\u001b[39m\r\n"]
[428.603683, "o", "\u001b[32m✔ named OpenRouter turns retain the platform and recorded turn association \u001b[90m(1.023412ms)\u001b[39m\u001b[39m\r\n"]
[428.603867, "o", "\u001b[32m✔ LM Studio outer dates inherit only when version date is absent \u001b[90m(1.078725ms)\u001b[39m\u001b[39m\r\n"]
[428.604093, "o", "\u001b[32m✔ explicit Meta envelope provenance survives Claude-compatible shape \u001b[90m(0.591972ms)\u001b[39m\u001b[39m\r\n"]
