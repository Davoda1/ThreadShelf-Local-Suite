[509.485033, "o", "\u001b[1mdpkg-deb:\u001b[0m building package 'threadshelf-local-analytics' in '/tmp/threadshelf-demo/ThreadShelf-Local-Suite/release/threadshelf-local-analytics_1.0.0_amd64.deb'.\r\n"]
