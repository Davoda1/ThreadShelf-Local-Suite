+  const sib1Src = `${REMOTE_ORIGIN}${CHILD_PAGE}?frame_id=sib1&target_id=s1`;
+  const sib2Src = `${REMOTE_ORIGIN_2}${CHILD_PAGE}?frame_id=sib2&target_id=s2`;
+
+  await Promise.all([
+    loadChildFrame(sib1, sib1Src, 'sib1'),
+    loadChildFrame(sib2, sib2Src, 'sib2')
+  ]);
+
+  await new test_driver.Actions()
+    .addPointer('touchPointer', 'touch')
+    .pointerMove(0, 0, {origin: sib1})
+    .pointerDown()
+    .pointerMove(0, 0, {origin: sib2})
+    .pointerUp()
+    .send();
+
+  await tapDoneButton();
+
+  assert_equals(JSON.stringify(receivedMessages), JSON.stringify([
+    { frameId: 'sib1', type: 'pointerover', relatedTargetIsNull: true },
+    { frameId: 'sib1', type: 'pointerenter', relatedTargetIsNull: true },
+    { frameId: 'sib1', type: 'pointerout', relatedTargetIsNull: true },
+    { frameId: 'sib1', type: 'pointerleave', relatedTargetIsNull: true },
+    { frameId: 'sib2', type: 'pointerover', relatedTargetIsNull: true },
+    { frameId: 'sib2', type: 'pointerenter', relatedTargetIsNull: true },
+    { frameId: 'sib2', type: 'pointerout', relatedTargetIsNull: true },
+    { frameId: 'sib2', type: 'pointerleave', relatedTargetIsNull: true }
+  ]), 'receivedMessages should match expected sibling events');
+}, 'Sibling iframes: relatedTarget is null for both documents');
+
+promise_test(async t => {
+  receivedMessages = [];
+  const container = document.createElement('div');
+  document.body.appendChild(container);
+  t.add_cleanup(() => container.remove());
+
+  const topTarget = document.createElement('div');
+  topTarget.id = 'top-target-nested';
+  topTarget.className = 'target';
+  topTarget.style.background = 'cyan';
+  container.appendChild(topTarget);
+
+  const outerIframe = document.createElement('iframe');
+  outerIframe.id = 'outer-iframe';
+  container.appendChild(outerIframe);
+
+  const deepSrc = `${REMOTE_ORIGIN_2}${CHILD_PAGE}?frame_id=deep&target_id=deep`;
+  const outerSrc = `${REMOTE_ORIGIN}${CHILD_PAGE}?frame_id=outer&nested_parent=true&inner_src=${encodeURIComponent(deepSrc)}`;
+
+  await loadChildFrame(outerIframe, outerSrc, 'deep');
+
+  let topEvents = [];
+  topTarget.addEventListener('pointerdown', e => {
+    e.target.releasePointerCapture(e.pointerId);
+  });
+  ['pointerout', 'pointerleave'].forEach(type => {
+    topTarget.addEventListener(type, e => {
+      topEvents.push({ type: e.type, relatedTarget: e.relatedTarget });
+    });
+  });
+
+  await new test_driver.Actions()
+    .addPointer('touchPointer', 'touch')
+    .pointerMove(0, 0, {origin: topTarget})
+    .pointerDown()
+    .pointerMove(0, 0, {origin: outerIframe})
+    .pointerUp()
+    .send();
+
+  await tapDoneButton();
+
+  assert_equals(
+    topEvents.map(e => `${e.type} from ${e.relatedTarget.id}`).join(),
+    "pointerout from outer-iframe,pointerleave from outer-iframe"
+  );
+
+  assert_equals(JSON.stringify(receivedMessages), JSON.stringify([
+    { frameId: 'deep', type: 'pointerover', relatedTargetIsNull: true },
+    { frameId: 'deep', type: 'pointerenter', relatedTargetIsNull: true },
+    { frameId: 'deep', type: 'pointerout', relatedTargetIsNull: true },
+    { frameId: 'deep', type: 'pointerleave', relatedTargetIsNull: true }
+  ]), 'receivedMessages should match expected deep child events');
+}, 'Nested iframes: relatedTarget in outer document is outermost iframe, inner document is null');
+
+promise_test(async t => {
+  receivedMessages = [];
+  const container = document.createElement('div');
+  document.body.appendChild(container);
+  t.add_cleanup(() => container.remove());
+
+  const parentTarget = document.createElement('div');
+  parentTarget.id = 'parent-target';
+  parentTarget.className = 'target';
+  container.appendChild(parentTarget);
+
+  const iframe = document.createElement('iframe');
+  iframe.id = 'iframe';
+  container.appendChild(iframe);
+
+  const childSrc = `${REMOTE_ORIGIN}${CHILD_PAGE}?frame_id=child&target_id=child-target&report_pointerdown=true`;
+  await loadChildFrame(iframe, childSrc, 'child');
+
+  let parentEvents = [];
+  ['pointerover', 'pointerenter'].forEach(type => {
+    parentTarget.addEventListener(type, e => {
+      parentEvents.push({ type: e.type, relatedTargetIsNull: e.relatedTarget === null });
+    });
+  });
+
+  const onMessage = e => {
+    if (e.data && e.data.source === 'boundary-event-test' && e.data.type === 'child-pointerdown') {
+      iframe.remove();
+    }
+  };
+  window.addEventListener('message', onMessage);
+  t.add_cleanup(() => window.removeEventListener('message', onMessage));
+
+  await new test_driver.Actions()
+    .addPointer('touchPointer', 'touch')
+    .pointerMove(0, 0, {origin: iframe})
+    .pointerDown()
+    .pause(200)
+    .pointerMove(0, 0, {origin: parentTarget})
+    .pointerUp()
+    .send();
+
+  await tapDoneButton();
+
+  assert_equals(
+    parentEvents.map(e => `${e.type} (null: ${e.relatedTargetIsNull})`).join(),
+    "pointerover (null: true),pointerenter (null: true)"
+  );
+}, 'Iframe to parent with iframe removed: relatedTarget in outer document is null');
+</script>
+</body>
diff --git a/third_party/blink/web_tests/external/wpt/pointerevents/resources/pointerevent_boundary_events_cross_origin_child.html b/third_party/blink/web_tests/external/wpt/pointerevents/resources/pointerevent_boundary_events_cross_origin_child.html
new file mode 100644
index 0000000..d7dae4e
--- /dev/null
+++ b/third_party/blink/web_tests/external/wpt/pointerevents/resources/pointerevent_boundary_events_cross_origin_child.html
@@ -0,0 +1,70 @@
+<!doctype html>
+<html>
+<head>
+  <meta charset="utf-8">
+  <style>
+    html, body {
+      margin: 0;
+      padding: 0;
+      touch-action: none;
+    }
+    .target {
+      width: 100px;
+      height: 100px;
+      touch-action: none;
+    }
+    #s1 { background: green; }
+    #s2 { background: red; }
+    #child-target { background: green; }
+    #deep { background: orange; }
+    iframe {
+      width: 100px;
+      height: 100px;
+      border: none;
+      display: block;
+    }
+  </style>
+</head>
+<body>
+  <div id="target" class="target"></div>
+  <script>
+    const params = new URLSearchParams(location.search);
+    const frameId = params.get('frame_id') || 'child';
+    const targetId = params.get('target_id') || 'child-target';
+    const isNestedParent = params.get('nested_parent') === 'true';
+
+    const targetEl = document.getElementById('target');
+    targetEl.id = targetId;
+
+    if (isNestedParent) {
+      targetEl.remove();
+      const innerIframe = document.createElement('iframe');
+      innerIframe.id = 'inner-iframe';
+      innerIframe.src = params.get('inner_src');
+      document.body.appendChild(innerIframe);
+    } else {
+      targetEl.addEventListener('pointerdown', e => {
+        e.target.releasePointerCapture(e.pointerId);
+        if (params.get('report_pointerdown') === 'true') {
+          window.top.postMessage({
+            source: 'boundary-event-test',
+            frameId: frameId,
+            type: 'child-pointerdown'
+          }, '*');
+        }
+      });
+      ['pointerover', 'pointerenter', 'pointerout', 'pointerleave'].forEach(type => {
+        targetEl.addEventListener(type, e => {
+          window.top.postMessage({
+            source: 'boundary-event-test',
+            frameId: frameId,
+            type: e.type,
+            relatedTargetIsNull: e.relatedTarget === null
+          }, '*');
+        });
+      });
+      window.top.postMessage({ source: 'boundary-event-test', frameId: frameId, type: 'child-ready' }, '*');
+    }
+  </script>
+</body>
+</html>
diff --git a/third_party/blink/web_tests/external/wpt/web-animations/crashtests/null-timeline-backdrop-filter-crash.html b/third_party/blink/web_tests/external/wpt/web-animations/crashtests/null-timeline-backdrop-filter-crash.html
