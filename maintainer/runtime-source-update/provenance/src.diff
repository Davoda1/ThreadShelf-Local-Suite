+<!DOCTYPE html>
+<html class="reftest-wait">
+<meta charset="utf-8">
+  <title>backdrop-filter: An animated SVG feDisplacement filter is pass through</title>
+  <link rel="help" href="https://drafts.fxtf.org/filter-effects-2/#BackdropFilterProperty">
+  <link rel="match"  href="css-backdrop-filters-animation-displacement-ref.html">
+  <script src="/common/reftest-wait.js"></script>
+
+  <style>
+    @keyframes animate-backdrop {
+      0% {
+        backdrop-filter: url(#displacement);
+      }
+      99% {
+        backdrop-filter: url(#displacement);
+      }
+      100% {
+        backdrop-filter: none;
+      }
+    }
+
+    .whitebox {
+      position: absolute;
+      background: white;
+      width: 100px;
+      height: 100px;
+      top: 50px;
+      left: 50px;
+    }
+
+    .filter {
+      background-color: transparent;
+      position: absolute;
+      width: 200px;
+      height: 200px;
+      top: 0px;
+      left: 0px;
+      animation: animate-backdrop 10s linear;
+    }
+  </style>
+
+  <div class="whitebox"></div>
+  <div class="filter"></div>
+
+  <svg width="0" height="0">
+    <filter id="displacement" filterUnits="userSpaceOnUse" x="0" y="0" width="200" height="200">
+      <feFlood result="flood" flood-color="green" x="50" y="50" width="100" height="100"/>
+      <feDisplacementMap in2="SourceGraphic" in="flood" xChannelSelector="G" yChannelSelector="G" scale="20"/>
+    </filter>
+  </svg>
+  <script>
+    onload = () => {
+      const anim = document.getAnimations()[0];
+      anim.ready.then(() => {
+        requestAnimationFrame(() => {
+          requestAnimationFrame(takeScreenshot);
+        });
+      });
+    };
+  </script>
+</html>
