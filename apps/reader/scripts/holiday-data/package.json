{
  "name": "threadshelf-offline-holidays",
  "description": "Reproducible offline holiday rule data and browser engine for ThreadShelf Local Suite",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test holiday-engine.test.mjs safe-merge.test.mjs",
    "check": "npm run build && npm test"
  },
  "type": "module",
  "dependencies": {
    "date-holidays": "3.38.0",
    "date-holidays-parser": "3.4.7",
    "esbuild": "0.28.2",
    "deepmerge": "file:./safe-merge"
  },
  "private": true,
  "suiteVersion": "1.3.0",
  "engines": {
    "node": "26.13.0",
    "npm": "12.2.2"
  },
  "packageManager": "npm@12.2.2",
  "overrides": {
    "deepmerge": "$deepmerge"
  }
}
